{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openclaw:v3:document-intake-analyst:output",
  "title": "Document intake analyst output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role", "status", "lead_id", "run_id", "assumptions", "missing_data",
    "evidence", "confidence", "result", "risks", "warnings", "recommended_next_agent", "persistence_request", "error"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "role": { "const": "document-intake-analyst" },
    "status": { "$ref": "#/$defs/status" },
    "lead_id": { "$ref": "#/$defs/nullableId" },
    "run_id": { "$ref": "#/$defs/nullableId" },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "missing_data": { "type": "array", "items": { "$ref": "#/$defs/missingItem" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "confidence": { "$ref": "#/$defs/confidence" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id", "document_ref", "filename", "sha256", "declared_mime", "detected_mime",
        "storage_tier", "confidentiality", "retention_class", "parse_status", "parser",
        "extraction_executor", "deterministic_extraction_ref", "truncated", "claims", "coverage_manifest",
        "parse_limitations", "limits_applied", "quarantine"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "document_ref": { "$ref": "#/$defs/id" },
        "filename": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "declared_mime": { "type": ["string", "null"] },
        "detected_mime": {
          "enum": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "text/csv",
            "application/vnd.ms-excel",
            "application/octet-stream"
          ]
        },
        "storage_tier": { "enum": ["public", "internal", "confidential", "restricted", "quarantine"] },
        "confidentiality": { "enum": ["public", "internal", "confidential", "restricted", "unknown"] },
        "retention_class": { "type": "string", "minLength": 1 },
        "parse_status": {
          "enum": [
            "complete", "partial", "quarantined_legacy_xls", "quarantined_unsafe", "unsupported",
            "encrypted", "corrupt", "limit_exceeded", "failed"
          ]
        },
        "parser": {
          "anyOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["name", "version"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "extraction_executor": { "const": "deterministic_pipeline" },
        "deterministic_extraction_ref": { "$ref": "#/$defs/id" },
        "truncated": { "type": "boolean" },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "original_text", "fact_status", "source_ref", "location", "formula_text", "cached_value"],
            "properties": {
              "claim_id": { "$ref": "#/$defs/id" },
              "original_text": { "type": "string", "minLength": 1 },
              "fact_status": { "const": "submitted_claim" },
              "source_ref": { "$ref": "#/$defs/id" },
              "location": { "$ref": "#/$defs/location" },
              "formula_text": { "type": ["string", "null"] },
              "cached_value": { "type": ["string", "number", "boolean", "null"] }
            }
          }
        },
        "coverage_manifest": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["unit_id", "unit_type", "status", "limitation_codes"],
            "properties": {
              "unit_id": { "$ref": "#/$defs/id" },
              "unit_type": { "enum": ["file", "page", "slide", "sheet", "table", "object"] },
              "status": { "enum": ["extracted", "skipped", "truncated", "quarantined"] },
              "limitation_codes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/limitationCode" } }
            }
          }
        },
        "parse_limitations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "scope", "detail"],
            "properties": {
              "code": { "$ref": "#/$defs/limitationCode" },
              "scope": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        },
        "limits_applied": {
          "type": "object", "additionalProperties": false,
          "required": ["max_bytes", "max_pages", "max_sheets", "max_rows", "max_columns", "max_cells", "max_text_chars"],
          "properties": {
            "max_bytes": { "type": ["integer", "null"], "minimum": 1 },
            "max_pages": { "type": ["integer", "null"], "minimum": 1 },
            "max_sheets": { "type": ["integer", "null"], "minimum": 1 },
            "max_rows": { "type": ["integer", "null"], "minimum": 1 },
            "max_columns": { "type": ["integer", "null"], "minimum": 1 },
            "max_cells": { "type": ["integer", "null"], "minimum": 1 },
            "max_text_chars": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "quarantine": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "recommended", "reason_codes", "approved_conversion_required", "conversion_path"],
          "properties": {
            "required": { "type": "boolean" },
            "recommended": { "type": "boolean" },
            "reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "approved_conversion_required": { "type": "boolean" },
            "conversion_path": { "enum": ["none", "operator_approved_deterministic_conversion"] }
          }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "recommended_next_agent": {
      "anyOf": [{ "enum": ["inbound-intake-analyst", "lead-router", "data-steward", "vc-chief"] }, { "type": "null" }]
    },
    "persistence_request": { "$ref": "#/$defs/persistenceRequest" },
    "error": { "$ref": "#/$defs/error" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": { "detected_mime": { "const": "application/vnd.ms-excel" } },
            "required": ["detected_mime"]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "parse_status": { "const": "quarantined_legacy_xls" },
              "storage_tier": { "const": "quarantine" },
              "claims": { "maxItems": 0 },
              "quarantine": {
                "properties": {
                  "required": { "const": true },
                  "recommended": { "const": true },
                  "approved_conversion_required": { "const": true },
                  "conversion_path": { "const": "operator_approved_deterministic_conversion" }
                },
                "required": ["required", "recommended", "approved_conversion_required", "conversion_path"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": { "parse_status": { "enum": ["complete", "partial"] } },
            "required": ["parse_status"]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "detected_mime": {
                "enum": [
                  "application/pdf",
                  "application/vnd.openxmlformats-officedocument.presentationml.presentation",
                  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                  "text/csv"
                ]
              },
              "parser": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": { "truncated": { "const": true } },
            "required": ["truncated"]
          }
        }
      },
      "then": {
        "properties": {
          "result": { "properties": { "parse_status": { "enum": ["partial", "limit_exceeded"] } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": { "parse_status": { "enum": ["partial", "limit_exceeded"] } },
            "required": ["parse_status"]
          }
        }
      },
      "then": {
        "properties": {
          "result": { "properties": { "parse_limitations": { "minItems": 1 } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": { "properties": { "error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "properties": { "error": { "not": { "type": "null" } } } }
    }
  ],
  "$defs": {
    "status": { "enum": ["ok", "insufficient_evidence", "needs_human_review", "failed"] },
    "id": { "type": "string", "minLength": 1 },
    "nullableId": { "type": ["string", "null"], "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "missingItem": {
      "type": "object", "additionalProperties": false, "required": ["field", "status", "reason"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "status": { "enum": ["absent", "not_disclosed", "not_applicable", "extraction_failed", "not_requested"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "evidenceItem": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_ref", "claim", "location", "fact_status"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/id" },
        "source_ref": { "$ref": "#/$defs/id" },
        "claim": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" },
        "fact_status": { "const": "submitted_claim" }
      }
    },
    "location": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "slide", "section"],
          "properties": {
            "kind": { "const": "presentation" },
            "slide": { "type": "integer", "minimum": 1 },
            "section": { "enum": ["slide", "notes"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "page", "bounding_context"],
          "properties": {
            "kind": { "const": "pdf" },
            "page": { "type": "integer", "minimum": 1 },
            "bounding_context": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "sheet", "cell_range"],
          "properties": {
            "kind": { "const": "spreadsheet" },
            "sheet": { "type": "string", "minLength": 1 },
            "cell_range": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*(:[A-Z]+[1-9][0-9]*)?$" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "row_start", "row_end", "columns"],
          "properties": {
            "kind": { "const": "csv" },
            "row_start": { "type": "integer", "minimum": 1 },
            "row_end": { "type": "integer", "minimum": 1 },
            "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "limitationCode": {
      "enum": [
        "truncated", "page_limit", "slide_limit", "sheet_limit", "row_limit", "column_limit", "cell_limit", "text_limit",
        "ocr_used", "ocr_unavailable", "hidden_content", "chart_or_image_only", "formula_present", "external_link",
        "unsupported_object", "legacy_xls", "other"
      ]
    },
    "persistenceRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["requested", "operation", "reason", "steward_required"],
      "properties": {
        "requested": { "type": "boolean" },
        "operation": { "enum": ["none", "record_document_claims"] },
        "reason": { "type": ["string", "null"] },
        "steward_required": { "const": true }
      },
      "allOf": [
        { "if": { "properties": { "requested": { "const": false } } }, "then": { "properties": { "operation": { "const": "none" } } } },
        {
          "if": { "properties": { "requested": { "const": true } } },
          "then": { "properties": { "operation": { "const": "record_document_claims" }, "reason": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "error": {
      "oneOf": [
        { "type": "null" }, {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
