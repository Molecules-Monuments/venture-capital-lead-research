name: vc-inbound-intake-v3
# SPDX-License-Identifier: Apache-2.0

# All caller values arrive through Lobster's argsJson contract. Commands read
# only the quoted LOBSTER_ARG_* environment variables generated by Lobster.
args:
  idempotency_key:
    default: ""
  lead_title:
    default: ""
  company_name:
    default: ""
  company_domain:
    default: ""
  document_path:
    default: ""
  channel_provider:
    default: ""
  channel_account_id:
    default: ""
  channel_event_id:
    default: ""
  # Injected by vcrun after argument validation (never caller-supplied):
  # the sha256 of the canonical argument payload, which binds this run row
  # to exactly these arguments so a reused key with changed arguments fails
  # closed instead of silently sharing the earlier run.
  input_digest:
    default: ""

steps:
  - id: preflight
    run: /workspaces/vc-chief/vc/bin/vcops-workflow preflight
    timeout_ms: 10000

  - id: document_preview
    run: >-
      /workspaces/vc-chief/vc/bin/vcops-workflow document-preview
      --path "$LOBSTER_ARG_DOCUMENT_PATH"
    timeout_ms: 30000

  - id: workflow_request_claim
    env:
      VCOPS_DOCUMENT_SHA256: "$document_preview.json.sha256"
    run: >-
      /workspaces/vc-chief/vc/bin/vcops-workflow workflow-request-claim
      --workflow inbound-intake
      --idempotency-key "$LOBSTER_ARG_IDEMPOTENCY_KEY"
      --lead-title "$LOBSTER_ARG_LEAD_TITLE"
      --company-name "$LOBSTER_ARG_COMPANY_NAME"
      --company-domain "$LOBSTER_ARG_COMPANY_DOMAIN"
      --document-path "$LOBSTER_ARG_DOCUMENT_PATH"
      --document-sha256 "$VCOPS_DOCUMENT_SHA256"
      --channel-provider "$LOBSTER_ARG_CHANNEL_PROVIDER"
      --channel-account-id "$LOBSTER_ARG_CHANNEL_ACCOUNT_ID"
      --channel-event-id "$LOBSTER_ARG_CHANNEL_EVENT_ID"
    timeout_ms: 20000

  - id: company_resolve_create
    env:
      VCOPS_WORKFLOW_REQUEST_ID: "$workflow_request_claim.json.workflow_request.id"
    run: >-
      /workspaces/vc-chief/vc/bin/vcops-workflow company-resolve-create
      --workflow-request-id "$VCOPS_WORKFLOW_REQUEST_ID"
      --workflow inbound-intake
      --idempotency-key "$LOBSTER_ARG_IDEMPOTENCY_KEY"
      --name "$LOBSTER_ARG_COMPANY_NAME"
      --domain "$LOBSTER_ARG_COMPANY_DOMAIN"
      --requester-id workflow:inbound-intake
      --purpose company_creation
      --max-confidentiality internal
    timeout_ms: 20000

  - id: create_lead
    env:
      VCOPS_COMPANY_ID: "$company_resolve_create.json.company.id"
    run: >-
      /workspaces/vc-chief/vc/bin/vcops-workflow create-lead
      --company-id "$VCOPS_COMPANY_ID"
      --lead-title "$LOBSTER_ARG_LEAD_TITLE"
      --origin-group inbound
      --origin-subtype document_upload
      --origin-confidence low
      --channel-provider "$LOBSTER_ARG_CHANNEL_PROVIDER"
      --channel-account-id "$LOBSTER_ARG_CHANNEL_ACCOUNT_ID"
      --channel-event-id "$LOBSTER_ARG_CHANNEL_EVENT_ID"
      --idempotency-key "$LOBSTER_ARG_IDEMPOTENCY_KEY"
    timeout_ms: 20000

  - id: workflow_start
    env:
      VCOPS_LEAD_ID: "$create_lead.json.lead.id"
      VCOPS_COMPANY_ID: "$company_resolve_create.json.company.id"
    run: >-
      /workspaces/vc-chief/vc/bin/vcops-workflow workflow-start
      --workflow inbound-intake
      --lead-id "$VCOPS_LEAD_ID"
      --company-id "$VCOPS_COMPANY_ID"
      --idempotency-key "$LOBSTER_ARG_IDEMPOTENCY_KEY"
      --input-digest "$LOBSTER_ARG_INPUT_DIGEST"
    timeout_ms: 20000

  - id: workflow_running
    env:
      VCOPS_RUN_ID: "$workflow_start.json.workflow_run.run_id"
      VCOPS_EXPECTED_REVISION: "$workflow_start.json.workflow_run.record_version"
    run: >-
      /workspaces/vc-chief/vc/bin/vcops-workflow workflow-transition
      --run-id "$VCOPS_RUN_ID"
      --status running
      --expected-revision "$VCOPS_EXPECTED_REVISION"
    timeout_ms: 20000

  # --confidentiality is `internal`, not `confidential`, and that is specific to
  # this lane. The file was placed on the deployment host by the operator,
  # through a read-only mount no channel can reach, precisely so this deployment
  # could analyse it; unlike a channel attachment there is no second principal to
  # withhold it from. Classifying it above the model ceiling made the lead's own
  # deck invisible to `lead-show` and unreadable by every lane, which silently
  # ended the documented document-to-memo path. Channel attachments
  # (document-ingest) stay `confidential`: those are bound to one verified sender
  # and are read only with that sender's capability. --trust-level is unchanged —
  # the CONTENT remains untrusted input whose instructions are never followed.
  - id: document_extract
    env:
      VCOPS_LEAD_ID: "$create_lead.json.lead.id"
      VCOPS_WORKFLOW_ROW_ID: "$workflow_start.json.workflow_run.id"
      VCOPS_WORKFLOW_REQUEST_ID: "$workflow_request_claim.json.workflow_request.id"
    run: >-
      /workspaces/vc-chief/vc/bin/vcops-workflow document-extract
      --path "$LOBSTER_ARG_DOCUMENT_PATH"
      --lead-id "$VCOPS_LEAD_ID"
      --workflow-run-id "$VCOPS_WORKFLOW_ROW_ID"
      --workflow-request-id "$VCOPS_WORKFLOW_REQUEST_ID"
      --idempotency-key "$LOBSTER_ARG_IDEMPOTENCY_KEY"
      --trust-level untrusted_upload
      --confidentiality internal
      --retention-class standard
    timeout_ms: 120000

  - id: workflow_succeeded
    env:
      VCOPS_RUN_ID: "$workflow_running.json.workflow_run.run_id"
      VCOPS_EXPECTED_REVISION: "$workflow_running.json.workflow_run.record_version"
    run: >-
      /workspaces/vc-chief/vc/bin/vcops-workflow workflow-transition
      --run-id "$VCOPS_RUN_ID"
      --status succeeded
      --expected-revision "$VCOPS_EXPECTED_REVISION"
    timeout_ms: 20000
