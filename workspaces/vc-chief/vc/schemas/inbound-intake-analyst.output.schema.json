{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openclaw:v3:inbound-intake-analyst:output",
  "title": "Inbound intake analyst output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role", "status", "lead_id", "run_id", "assumptions", "missing_data",
    "evidence", "confidence", "result", "risks", "warnings", "recommended_next_agent", "persistence_request", "error"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "role": { "const": "inbound-intake-analyst" },
    "status": { "$ref": "#/$defs/status" },
    "lead_id": { "$ref": "#/$defs/nullableId" },
    "run_id": { "$ref": "#/$defs/nullableId" },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "missing_data": { "type": "array", "items": { "$ref": "#/$defs/missingItem" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
    "confidence": { "$ref": "#/$defs/confidence" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin", "intake_channel", "received_at", "source_ids", "trust", "submitter_or_referrer", "company",
        "documents", "submitted_claims", "verified_public_facts", "consent", "lawful_basis", "duplicate_candidates",
        "approval_risks"
      ],
      "properties": {
        "origin": {
          "type": "object", "additionalProperties": false, "required": ["group", "subtype", "confidence"],
          "properties": {
            "group": { "const": "inbound" },
            "subtype": { "enum": ["direct_contact", "network_referral", "event_followup", "unknown"] },
            "confidence": { "$ref": "#/$defs/confidence" }
          }
        },
        "intake_channel": { "type": "string", "minLength": 1 },
        "received_at": { "type": "string", "format": "date-time" },
        "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "authorized_sender", "confidentiality", "storage_tier", "retention_class", "approval_required", "reason"],
          "properties": {
            "level": { "enum": ["trusted_internal", "known_external", "unknown_external", "untrusted", "ambiguous"] },
            "authorized_sender": { "enum": ["yes", "no", "unknown"] },
            "confidentiality": { "enum": ["public", "internal", "confidential", "restricted", "unknown"] },
            "storage_tier": { "enum": ["public", "internal", "confidential", "restricted", "quarantine"] },
            "retention_class": { "type": "string", "minLength": 1 },
            "approval_required": { "type": "boolean" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "submitter_or_referrer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stable_id", "display_label", "relationship"],
          "properties": {
            "stable_id": { "$ref": "#/$defs/nullableId" },
            "display_label": { "type": ["string", "null"] },
            "relationship": { "type": ["string", "null"] }
          }
        },
        "company": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "legal_name", "website", "normalized_domain"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "legal_name": { "type": ["string", "null"] },
            "website": { "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }] },
            "normalized_domain": { "type": ["string", "null"], "pattern": "^[a-z0-9.-]+$" }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["document_ref", "artifact_id", "parse_status"],
            "properties": {
              "document_ref": { "$ref": "#/$defs/id" },
              "artifact_id": { "$ref": "#/$defs/nullableId" },
              "parse_status": { "enum": ["not_requested", "pending", "complete", "partial", "failed", "quarantined"] }
            }
          }
        },
        "submitted_claims": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["claim_id", "claim", "source_ref"],
            "properties": {
              "claim_id": { "$ref": "#/$defs/id" },
              "claim": { "type": "string", "minLength": 1 },
              "source_ref": { "$ref": "#/$defs/id" }
            }
          }
        },
        "verified_public_facts": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fact_id", "claim", "source_refs", "verified_at"],
            "properties": {
              "fact_id": { "$ref": "#/$defs/id" },
              "claim": { "type": "string", "minLength": 1 },
              "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
              "verified_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "consent": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "scope", "evidence_ref"],
          "properties": {
            "status": { "enum": ["granted", "denied", "not_requested", "unknown", "not_applicable"] },
            "scope": { "type": ["string", "null"] },
            "evidence_ref": { "$ref": "#/$defs/nullableId" }
          }
        },
        "lawful_basis": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "basis", "evidence_ref"],
          "properties": {
            "status": { "enum": ["documented", "missing", "not_applicable", "needs_review"] },
            "basis": { "enum": ["consent", "contract", "legitimate_interests", "legal_obligation", "public_task", "vital_interests", "unknown", "not_applicable"] },
            "evidence_ref": { "$ref": "#/$defs/nullableId" }
          }
        },
        "duplicate_candidates": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["match_id", "method", "confidence"],
            "properties": {
              "match_id": { "$ref": "#/$defs/id" },
              "method": { "enum": ["exact_domain", "exact_name", "alias", "semantic", "manual_hint"] },
              "confidence": { "$ref": "#/$defs/confidence" }
            }
          }
        },
        "approval_risks": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "reason", "required_action"],
            "properties": {
              "code": { "enum": ["trust", "consent", "lawful_basis", "confidentiality", "retention", "identity", "other"] },
              "reason": { "type": "string", "minLength": 1 },
              "required_action": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "recommended_next_agent": {
      "anyOf": [{ "enum": ["document-intake-analyst", "lead-router", "data-steward", "vc-chief"] }, { "type": "null" }]
    },
    "persistence_request": { "$ref": "#/$defs/persistenceRequest" },
    "error": { "$ref": "#/$defs/error" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "ok" } } }, "then": { "properties": { "error": { "type": "null" } } } },
    { "if": { "properties": { "status": { "const": "failed" } } }, "then": { "properties": { "error": { "not": { "type": "null" } } } } }
  ],
  "$defs": {
    "status": { "enum": ["ok", "insufficient_evidence", "needs_human_review", "failed"] },
    "id": { "type": "string", "minLength": 1 },
    "nullableId": { "type": ["string", "null"], "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "missingItem": {
      "type": "object", "additionalProperties": false, "required": ["field", "status", "reason", "source_ref"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "status": { "enum": ["absent", "not_disclosed", "not_applicable", "extraction_failed", "not_requested"] },
        "reason": { "type": ["string", "null"] },
        "source_ref": { "$ref": "#/$defs/nullableId" }
      }
    },
    "evidenceItem": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "claim", "source_ref", "fact_status", "received_or_verified_at"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/id" },
        "claim": { "type": "string", "minLength": 1 },
        "source_ref": { "$ref": "#/$defs/id" },
        "fact_status": { "enum": ["submitted_claim", "verified_fact", "inference"] },
        "received_or_verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "persistenceRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["requested", "operation", "reason", "steward_required"],
      "properties": {
        "requested": { "type": "boolean" },
        "operation": { "enum": ["none", "capture_candidate", "update_candidate", "record_intake"] },
        "reason": { "type": ["string", "null"] },
        "steward_required": { "const": true }
      },
      "allOf": [
        { "if": { "properties": { "requested": { "const": false } } }, "then": { "properties": { "operation": { "const": "none" } } } },
        {
          "if": { "properties": { "requested": { "const": true } } },
          "then": { "properties": { "operation": { "enum": ["capture_candidate", "update_candidate", "record_intake"] }, "reason": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "error": {
      "oneOf": [
        { "type": "null" }, {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
