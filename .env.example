# [MUST_CUSTOMIZE] Copy to .env, fill every required value, and run
# scripts/check_env.sh. Also complete config/customization-profile.json; the
# bootstrap refuses the publication example until both validators pass.
TZ=Europe/Berlin

# Images are deliberately version-pinned. Record deployment digests in
# deployment-lock.json after the first pull; do not substitute latest/main.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.8.1@sha256:e7849cb6c1ef1ead39ab4be7d85edb2df89611f486e283284c7cf35ce39a20d4
POSTGRES_IMAGE=postgres:17.10-bookworm@sha256:4f736ae292687621d4dbe0d499ffd024a36bd2ee7d8ca6f2ccd4c800f047b394

# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
POSTGRES_PASSWORD=
OPENCLAW_DB_PASSWORD=
VCOPS_APPROVAL_PEPPER=
# Dedicated HMAC key for short-lived trusted channel/request capabilities.
# Generate with: openssl rand -hex 32. Never reuse another deployment key.
VC_TRUSTED_CONTEXT_KEY=
# Separate 256-bit key used only to authenticate backup checksum manifests.
# Generate with: openssl rand -hex 32. Transfer it independently of backups.
BACKUP_HMAC_KEY=
# Optional. Bound backup.sh/restore.sh apply to the state recovery archive,
# in bytes; leave empty for the 2 GiB default. Accepted range is 1 GiB through
# 100 GiB. Governed document snapshots and extractions accumulate in this tier,
# so a deployment with sustained attachment intake must raise it (and size the
# state volume to match) before backups begin to fail.
OPENCLAW_STATE_ARCHIVE_MAX_BYTES=

# [MUST_CUSTOMIZE] Wire a live model here. Three provider modes are supported:
#   openai  — OpenClaw's built-in OpenAI runtime; set OPENAI_API_KEY below.
#   ollama  — a local native Ollama endpoint; set VC_OLLAMA_BASE_URL below.
#   custom  — any reviewed HTTPS provider that speaks one supported API
#             (e.g. Anthropic/Claude, Azure OpenAI, an OpenAI-compatible gateway);
#             set the four VC_CUSTOM_* values below.
# The model IDs below are PLACEHOLDERS. Set VC_PRIMARY_MODEL and VC_FAST_MODEL to
# model IDs your chosen provider actually serves (format: "<provider>/<model>"),
# or the first real request will be rejected. VC_PRIMARY_MODEL is the reasoning/
# synthesis model; VC_FAST_MODEL is the cheaper triage model (they may be equal).
VC_MODEL_PROVIDER=openai
VC_PRIMARY_MODEL=openai/gpt-5.6-sol
VC_FAST_MODEL=openai/gpt-5.6-sol
# The five VC_MODEL_* values below describe the model to the runtime and take
# effect only for VC_MODEL_PROVIDER=ollama or =custom, where this package
# declares the model itself. In the shipped openai mode OpenClaw's built-in
# catalogue supplies them and these values are inert. They are still required
# and validated so a later provider switch cannot silently inherit blanks.
VC_MODEL_INPUT=text
VC_MODEL_REASONING=true
# In ollama mode this value is also sent to the Ollama server as num_ctx, so the
# machine running Ollama must be able to serve it. The default below is sized for
# the hosted OpenAI default, not for a local model.
VC_MODEL_CONTEXT_WINDOW=272000
VC_MODEL_MAX_TOKENS=16384
VC_MODEL_TIMEOUT_SECONDS=300
# Set the key for the selected provider only; leave the others blank.
OPENAI_API_KEY=
VC_OLLAMA_BASE_URL=
# custom-provider settings (used only when VC_MODEL_PROVIDER=custom).
# Example — Anthropic/Claude:
#   VC_MODEL_PROVIDER=custom
#   VC_PRIMARY_MODEL=anthropic/claude-opus-4-8
#   VC_FAST_MODEL=anthropic/claude-haiku-4-5
#   VC_CUSTOM_PROVIDER_ID=anthropic
#   VC_CUSTOM_BASE_URL=https://api.anthropic.com
#   VC_CUSTOM_API=anthropic-messages
#   VC_CUSTOM_API_KEY=<your Anthropic API key>
#   VC_WEB_SEARCH_PROVIDER=duckduckgo   # required: 'auto' is openai-runtime only
# Pick openai-responses only for a backend that implements /v1/responses; every
# other OpenAI-compatible gateway uses openai-completions.
VC_CUSTOM_PROVIDER_ID=
VC_CUSTOM_BASE_URL=
VC_CUSTOM_API=
VC_CUSTOM_API_KEY=

# Generic web_search remains the agent tool. auto uses the selected OpenAI
# runtime's ready/native provider. Local/custom models must choose an explicit
# provider. Ready out of the box: duckduckgo (keyless), firecrawl, tavily.
# Also native: brave, perplexity, exa (each needs its API key below), searxng
# (needs SEARXNG_BASE_URL), and parallel-free (keyless). A non-bundled provider
# additionally needs its plugin package pinned in runtime-packages and an image
# rebuild (see CUSTOMIZATION.md). Set the credential for the selected provider
# only; leave the others blank. (parallel-free is the keyless variant of the
# parallel plugin; the paid "parallel" provider is not offered.)
VC_WEB_SEARCH_PROVIDER=auto
VC_WEB_FETCH_PROVIDER=default
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
PERPLEXITY_API_KEY=
EXA_API_KEY=
SEARXNG_BASE_URL=

# Optional third-party research-connector (MCP) secrets. Set one only when the
# matching entry in config/connectors.json is enabled; leave blank otherwise.
# These three shipped example connectors are pre-wired into the container. A
# connector that uses a different variable name must also be added to
# scripts/check_env.py ALLOWED_KEYS and the docker-compose gateway/cli
# environment (a commissioning step — see third_party_connectors.md).
CRUNCHBASE_API_KEY=
PITCHBOOK_API_KEY=
DEALROOM_API_KEY=

# [MUST_CUSTOMIZE] Channel selection is fail-closed. Use exactly one of:
# none, slack, msteams, discord, telegram.
PRIMARY_CHANNEL=none
# Channel attachment ceiling (1-50 MiB). Note the document-extraction lane has
# its own hard 25 MiB cap that this value cannot raise; setting more than 25
# only allows larger non-document media through the channel, which this
# deployment blocks anyway. Leave at 25 unless you have a reviewed reason.
VC_CHANNEL_MEDIA_MAX_MB=25

# Optional channel activation values. Keep every unselected family blank.
# Stable destination IDs are rendered into object keys because OpenClaw only
# substitutes ${ENV} references in values, not keys.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USER_IDS=
SLACK_ALLOWED_CHANNEL_ID=
MSTEAMS_APP_ID=
MSTEAMS_APP_PASSWORD=
MSTEAMS_TENANT_ID=
MSTEAMS_ALLOWED_USER_IDS=
MSTEAMS_ALLOWED_TEAM_ID=
MSTEAMS_ALLOWED_CHANNEL_ID=
# Recorded and format-validated as a commissioning review artifact; nothing
# reads it at runtime (channel-msteams.json5 hardcodes the callback path). It
# documents the public HTTPS URL your reverse proxy maps to /api/messages.
MSTEAMS_PUBLIC_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_GROUP_ID=

# Loopback-only host bindings. Put a TLS reverse proxy in front of Teams.
OPENCLAW_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
MSTEAMS_WEBHOOK_HOST=127.0.0.1
MSTEAMS_WEBHOOK_PORT=3978

# [REVIEW_AND_CONFIRM] Stable named volumes keep runtime config and quarantine
# portable across package-directory or Compose project-name changes. Bounded
# per-user preferences live in Postgres; generic conversational memory remains
# disabled. All effective volumes must remain distinct. Change names only as
# part of a tested restore plan.
OPENCLAW_RUNTIME_CONFIG_VOLUME=vc-lead-research-v3_runtime-config
VC_QUARANTINE_VOLUME=vc-lead-research-v3_vc-quarantine

# Explicit container and local json-file log bounds. Increase only after a
# measured live-capacity test; values use Docker Compose units.
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
POSTGRES_LOG_MAX_SIZE=10m
POSTGRES_LOG_MAX_FILES=5
# The init lane's measured floor is 128m: at 64m the approvals CLI it runs is
# OOM-killed with a completely empty log, and at 96m it is still OOM-killed.
# Do not lower this below 128m.
OPENCLAW_INIT_MEMORY_LIMIT=256m
OPENCLAW_INIT_CPU_LIMIT=0.25
OPENCLAW_INIT_LOG_MAX_SIZE=1m
OPENCLAW_INIT_LOG_MAX_FILES=1
OPENCLAW_GATEWAY_MEMORY_LIMIT=2g
OPENCLAW_GATEWAY_CPU_LIMIT=2.0
OPENCLAW_GATEWAY_LOG_MAX_SIZE=10m
OPENCLAW_GATEWAY_LOG_MAX_FILES=5
OPENCLAW_CLI_MEMORY_LIMIT=1g
OPENCLAW_CLI_CPU_LIMIT=1.0
OPENCLAW_CLI_LOG_MAX_SIZE=5m
OPENCLAW_CLI_LOG_MAX_FILES=2
