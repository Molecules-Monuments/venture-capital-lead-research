# SPDX-License-Identifier: Apache-2.0
ARG OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1@sha256:6a31d44b2944e7adcd2b582bf6fb463111264ebca97a0201795b799135bd102c
FROM ${OPENCLAW_IMAGE}

USER root

# The official GHCR release intentionally prunes Lobster and the optional
# Slack, Teams, and Discord distributions. Install the complete reviewed runtime
# graph from its committed npm lock. `npm ci` verifies every registry integrity
# before exposing the one fixed Lobster CLI used by vcrun.
COPY runtime-packages/package.json runtime-packages/package-lock.json /opt/openclaw-runtime/
RUN npm ci --prefix /opt/openclaw-runtime \
      --omit=dev --omit=peer --ignore-scripts --no-audit --no-fund \
  && test "$(node -p "require('/opt/openclaw-runtime/node_modules/@clawdbot/lobster/package.json').version")" = "2026.6.11" \
  && test "$(node -p "require('/opt/openclaw-runtime/node_modules/@openclaw/slack/package.json').version")" = "2026.7.1" \
  && test "$(node -p "require('/opt/openclaw-runtime/node_modules/@openclaw/msteams/package.json').version")" = "2026.7.1" \
  && test "$(node -p "require('/opt/openclaw-runtime/node_modules/@openclaw/discord/package.json').version")" = "2026.7.1" \
  && test "$(node -p "require('/opt/openclaw-runtime/node_modules/@openclaw/firecrawl-plugin/package.json').version")" = "2026.7.1" \
  && test "$(node -p "require('/opt/openclaw-runtime/node_modules/@openclaw/tavily-plugin/package.json').version")" = "2026.7.1" \
  && test "$(node -p "require('/app/extensions/duckduckgo/package.json').version")" = "2026.7.1" \
  && test "$(node -p "require('/app/extensions/ollama/package.json').version")" = "2026.7.1" \
  && test "$(node -p "require('/app/extensions/telegram/package.json').version")" = "2026.7.1" \
  && ln -s /opt/openclaw-runtime/node_modules/@clawdbot/lobster/bin/lobster.js /usr/local/bin/openclaw-lobster \
  && ln -s /opt/openclaw-runtime /opt/openclaw-channel-plugins \
# Put the three reinstalled channel distributions where the harness's own
# extension scanner looks, which is what the complete upstream distribution
# does; the GHCR release only prunes them.
#
# This is not cosmetic. The harness grants its keyed store only to a plugin
# whose registry record is `origin: "bundled"` or a recorded trusted official
# install. A plugin named in `plugins.load.paths` is neither, so it resolves as
# a path/config origin and every code path that reaches openKeyedStore throws
# "openKeyedStore is only available for trusted plugins in this release". The
# Teams provider reaches it while *starting*: measured on a live deployment it
# exited 40 ms after "starting provider (port 3978)", crash-looped through all
# ten auto-restarts, and never bound its webhook port — while bootstrap.sh
# exited 0 and the container reported healthy. Slack and Discord carry the same
# call sites past authentication.
#
# Moved, not copied: /opt/openclaw-runtime keeps one source of truth for
# everything else (Lobster, the search plugins), and duplicating these three
# would add ~159 MB to the image. The version assertions above run first and
# still gate exactly which bytes get moved, so the hash-locked npm graph remains
# the only provenance for this code. run_g6_image.py reads them from the new
# location.
  && mv /opt/openclaw-runtime/node_modules/@openclaw/slack /app/dist/extensions/slack \
  && mv /opt/openclaw-runtime/node_modules/@openclaw/msteams /app/dist/extensions/msteams \
  && mv /opt/openclaw-runtime/node_modules/@openclaw/discord /app/dist/extensions/discord \
# These three npm builds import the host runtime by bare specifier
# ("openclaw/plugin-sdk/..."). A *bundled* plugin gets that specifier for free
# by Node self-reference from /app/package.json (name "openclaw", with a
# ./plugin-sdk/* exports map); a moved npm package cannot, because its nearest
# package.json is @openclaw/<name>, and `openclaw` is an optional peer that
# --omit=peer above never installs. The gateway's plugin loader installs its
# own alias resolver, so the providers themselves run either way — but the CLI
# paths that lazily import a plugin's doctor / security-audit chunk do not.
# Measured on this image before the symlink: `openclaw doctor` and
# `openclaw security audit` both exit 1 with
# "ERR_MODULE_NOT_FOUND: Cannot find package 'openclaw' imported from
# /app/dist/extensions/discord/dist/doctor-*.js" whenever PRIMARY_CHANNEL is
# discord — a command docs/RUNBOOK.md §5.1 and docs/CHANNELS.md step 7 both
# mandate for commissioning. Slack carries the same latent defect in its
# security-audit chunk. One symlink per extension restores the resolution the
# bundled layout would have given them.
  && for id in slack msteams discord; do \
       mkdir -p "/app/dist/extensions/$id/node_modules" \
       && ln -sfn /app "/app/dist/extensions/$id/node_modules/openclaw" \
       && ( cd "/app/dist/extensions/$id/dist" \
            && node --input-type=module \
                 -e "await import('openclaw/plugin-sdk/runtime-doctor')" ); \
     done

# Exact Debian point-release pins are a deliberate part of the reviewed release
# contract: these ten package versions, plus the rest of the apt closure they
# pull in, reproduced by the snapshot timestamp below rather than by pins of
# their own — in the reviewed build, 38 of the 45 packages this step adds to
# the base image carry no version pin. The bookworm main pool keeps only the
# current revision of each package, so when Debian ships the next point release
# these exact pins are eventually superseded and drop out of deb.debian.org.
# RECOVERY (documented in docs/RUNBOOK.md "Rebuilding after a Debian point
# release"): point apt at a snapshot dated at or after the date the reviewed
# image was built (docs/V3_RELEASE_EVIDENCE.md records 2026-08-20), delete the
# base image's own deb.debian.org source list — left in place it sits at the
# same priority 500 and apt takes the higher version from it, so the snapshot
# decides nothing — and add BOTH snapshot archives, since the poppler pair is a
# bookworm-security revision which never reaches the bookworm main suite:
#   SNAPSHOT=20260820T000000Z
#   rm -f /etc/apt/sources.list.d/debian.sources
#   { printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/%s/ bookworm main\n' "$SNAPSHOT"
#     printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/%s/ bookworm-security main\n' "$SNAPSHOT"
#   } > /etc/apt/sources.list.d/snapshot.list
# and rebuild; or bump the pins here and re-run every release gate.
# tests/v3/test_snapshot_recipe_currency.py holds the SNAPSHOT literal above to
# the one in docs/RUNBOOK.md and to that recorded rebuild date. The wrapper
# below turns the otherwise-opaque "E: Version '<version>' for '<package>' was not found" apt error into
# that actionable message instead of a bare non-zero exit.
# libpoppler126 is pinned alongside poppler-utils deliberately. poppler-utils
# declares `Depends: libpoppler126 (= <same version>)`, and the library is a
# separate binary package from the same source. Pinning only the tool left the
# library unpinned, so when bookworm-security shipped 22.12.0-2+deb12u3 for the
# pair, apt took the newer library as its candidate and refused the older pinned
# tool with "held broken packages" — a fresh build broke while every cached one
# kept working. Both names now move together, and a future security bump fails
# on the pin itself with the actionable message below instead of a dependency
# puzzle. Keep this pair in lockstep, and keep both in
# scripts/run_g6_image.py and tests/infrastructure.
RUN apt-get update \
  && { apt-get install -y --no-install-recommends \
        ca-certificates=20230311+deb12u1 \
        curl=7.88.1-10+deb12u15 \
        file=1:5.44-3 \
        jq=1.6-2.1+deb12u2 \
        libmagic1=1:5.44-3 \
        libpoppler126=22.12.0-2+deb12u3 \
        poppler-utils=22.12.0-2+deb12u3 \
        python3=3.11.2-1+b1 \
        python3-pip=23.0.1+dfsg-1 \
        python3-venv=3.11.2-1+b1 \
     || { echo "ERROR: a pinned Debian package version is no longer installable from the bookworm pool." >&2; \
          echo "Either the version was superseded and dropped, or a security update moved a package this" >&2; \
          echo "one depends on. This is the reviewed exact-pin release contract. Rebuild reproducibly by" >&2; \
          echo "pointing apt at a snapshot.debian.org timestamp that still carries these versions (see the" >&2; \
          echo "RECOVERY comment in Dockerfile.openclaw and docs/RUNBOOK.md), or bump the pins together and" >&2; \
          echo "re-run every release gate." >&2; \
          exit 1; }; } \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.lock /tmp/requirements.lock
RUN python3 -m venv /opt/vcops-venv \
  && /opt/vcops-venv/bin/pip install --no-cache-dir --disable-pip-version-check \
    --require-hashes -r /tmp/requirements.lock \
  && rm /tmp/requirements.lock

# Agent contracts, fixed workflows, and helper entry points are image-owned,
# not mutable host bind mounts. Per-user preference memory is stored in
# Postgres rather than in a writable agent workspace.
COPY --chown=root:root workspaces/ /workspaces/
COPY --chown=root:root runtime-extensions/vc-trusted-context/ /opt/openclaw-extensions/vc-trusted-context/
COPY --chown=root:root config/exec-approvals.json /opt/openclaw-seed/exec-approvals.json
# `a+rX` before `a-w` is load-bearing, not decoration. COPY preserves the build
# context's modes, and git creates a working tree with `0666 & ~umask` (`0777 &
# ~umask` for the executable helpers). On a host with the CIS/STIG default
# `umask 027` a clone therefore lands at 0640/0750, and `chmod -R a-w` alone
# turns that into 0440 files inside 0550 directories owned by root:root — which
# the `node` runtime user can neither traverse nor read. The build still exits
# 0, `verify_release.py --pristine` still passes (it hashes content, not modes),
# and the failure only surfaces later as an unreadable agent contract and a
# non-executable vcops/vcrun. `a+rX` grants read to all and execute only where
# one already exists (directories and the helper entry points), so every host
# produces the same reviewed mode set the release was verified against:
# directories 0555, regular files 0444, helper entry points 0555. `a-w` still
# removes every write bit, so the read-only guarantee below is unchanged.
RUN chmod -R a+rX,a-w /workspaces \
  && chmod -R a+rX,a-w /opt/openclaw-extensions/vc-trusted-context \
  && install -d -m 0700 -o node -g node /quarantine \
  && chmod 0444 /opt/openclaw-seed/exec-approvals.json

ENV PATH="/opt/vcops-venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Without this the derived image reports the base image's identity unchanged:
# title "OpenClaw", version 2026.7.1, licenses MIT, source/revision/url pointing
# at the upstream repository. That is wrong for an artifact that is version
# 3.0.0, is not an upstream build, and adds LGPL-3.0-only psycopg and GPL
# poppler-utils. Nothing in this package reads .Config.Labels, so this is
# provenance for whoever inspects the built image, not an input to any gate.
# licenses is NOASSERTION deliberately: THIRD_PARTY_NOTICES.md declines to state
# a closed licence inventory for the built image, and this label must not state
# one either. The four upstream-pointing labels are emptied rather than
# re-aimed — this package has no published source, revision, url or docs site.
#
# What this block does NOT reset is as much a part of the provenance story, so
# read the list as partial by design rather than as everything the base sets.
# Measured against the base digest pinned at the top of this file, the base
# carries eleven org.opencontainers.image.* labels; the eight below replace
# eight of them, and LABEL touches nothing it does not name, so these three
# arrive inherited:
#   * .base.name / .base.digest — docker.io/library/node:24-bookworm-slim and
#     its digest. These name the base of the PINNED OPENCLAW IMAGE, not the
#     image this one is built FROM: the FROM above is
#     ghcr.io/openclaw/openclaw:2026.7.1 at the digest pinned in OPENCLAW_IMAGE,
#     and these labels arrive from it unchanged. They are left that way on
#     purpose — THIRD_PARTY_NOTICES.md describes them with exactly that
#     attribution ("the base the pinned OpenClaw image is built on ... recorded
#     in that image's own labels") and cites them for the Node.js notices a
#     redistributor must preserve, so re-aiming them at the OpenClaw image would
#     remove the reference those notices depend on. Read OPENCLAW_IMAGE at the
#     top of this file for this image's own base.
#   * .created — the base's build timestamp, NOT this image's. `docker build`
#     sets the config `.Created` field; it does not touch this label, so unless
#     the label is set here the derived image reports the base's creation date
#     while `.Created` reports its own. It is left alone on purpose: a
#     per-build value in a label would make the image config differ on every
#     rebuild of identical inputs, which is the opposite of what the recorded
#     digests in scripts/record_images.py are for, and a hardcoded date here
#     would be a second copy of a release date that already lives in generated
#     evidence state. Read `docker inspect --format '{{.Created}}'` for when
#     this image was actually built.
#
# Placed last on purpose: LABEL after FROM would invalidate the build cache for
# every layer below it, and label order does not affect the resulting config.
LABEL org.opencontainers.image.title="Venture Capital Lead Research" \
      org.opencontainers.image.version="3.0.0" \
      org.opencontainers.image.description="Independent OpenClaw-derived lead-research runtime; not an official OpenClaw Foundation product" \
      org.opencontainers.image.licenses="NOASSERTION" \
      org.opencontainers.image.source="" \
      org.opencontainers.image.revision="" \
      org.opencontainers.image.url="" \
      org.opencontainers.image.documentation=""

USER node
