# OpenClaw Lead Research System 3.0 — repository root is this directory.
# Everything the deployable package needs is tracked; operator-supplied secrets,
# rendered runtime state, generated artifacts, and internal review material are not.

# ── Operator secrets & environment ──────────────────────────────────────────
# The real environment file and any variant. .env.example (the commented
# template) is the only .env* that is tracked.
.env
.env.*
!.env.example

# ── Rendered runtime config & materialized secrets ───────────────────────────
# render_channel_config.py writes the effective config and the four secret files
# here on every lifecycle path; they are regenerated from .env and never committed.
config/runtime/*
!config/runtime/.gitkeep

# ── Operator-supplied reviewed config (created from the *.example templates) ──
config/customization-profile.json
config/connectors.json

# ── Deployment state written at install/update time ──────────────────────────
deployment-lock.json

# ── Runtime data volumes & operator working directories ───────────────────────
data/postgres/
data/openclaw/
inbox/*
!inbox/.gitkeep
quarantine/*
!quarantine/.gitkeep
workspaces/*/.openclaw/
workspaces/*/memory/

# ── Internal review / audit / historical material (kept locally, not published)
# Adversarial audit narratives, source-analysis helpers, and the derivation
# baseline. Excluded from the distribution manifest and from git; the deployable
# package does not depend on any of it.
_internal/

# ── Local developer venv & live-testing harness ──────────────────────────────
# Both live inside the package directory for convenience but are NOT part of the
# distribution: the venv is machine-specific and the harness is scratch that
# drives throwaway deployments. They are excluded from git, from the release
# manifest (build_release_manifest.EXCLUDED_PREFIXES) and from the pristine
# inventory (verify_release.REVIEW_ONLY_ROOTS) — all three must agree, and
# verify_release asserts that agreement against the manifest.
openclaw-v3-dev-venv/
v3-live-testing/

# ── Python / tooling caches ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# ── Local databases ───────────────────────────────────────────────────────────
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── OS / editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
