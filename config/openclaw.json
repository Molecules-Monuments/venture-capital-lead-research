{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    },
    "tools": {
      "deny": [
        "browser",
        "exec",
        "spawn",
        "shell",
        "fs_write",
        "fs_delete",
        "fs_move",
        "apply_patch",
        "sessions_spawn",
        "sessions_send",
        "cron",
        "gateway",
        "nodes"
      ]
    }
  },
  "plugins": {
    "allow": [
      "vc-trusted-context"
    ],
    "load": {
      "paths": [
        "/app/extensions/vc-trusted-context"
      ]
    },
    "slots": {},
    "entries": {
      "vc-trusted-context": {
        "enabled": true
      }
    }
  },
  "models": {
    "providers": {}
  },
  "commands": {
    "native": false,
    "nativeSkills": false,
    "text": false,
    "bash": false,
    "config": false,
    "mcp": false,
    "plugins": false,
    "debug": false,
    "restart": false,
    "useAccessGroups": true
  },
  "skills": {
    "load": {
      "extraDirs": [
        "/workspaces/shared-skills"
      ]
    },
    "workshop": {
      "autonomous": {
        "enabled": false
      },
      "approvalPolicy": "pending",
      "allowSymlinkTargetWrites": false,
      "maxPending": 10,
      "maxSkillBytes": 40000
    },
    "entries": {
      "lead-routing": {
        "enabled": true
      },
      "inbound-intake": {
        "enabled": true
      },
      "outbound-sourcing": {
        "enabled": true
      },
      "document-extraction": {
        "enabled": true
      },
      "evidence-research": {
        "enabled": true
      },
      "evidence-scoring": {
        "enabled": true
      },
      "approval-gates": {
        "enabled": true
      },
      "data-persistence": {
        "enabled": true
      },
      "trust-boundary": {
        "enabled": true
      },
      "knowledge-modeling": {
        "enabled": true
      },
      "lead-memory-lookup": {
        "enabled": true
      },
      "compiled-truth": {
        "enabled": true
      },
      "lead-signal-detection": {
        "enabled": true
      },
      "contradiction-check": {
        "enabled": true
      },
      "trajectory-check": {
        "enabled": true
      },
      "governance-lint": {
        "enabled": true
      },
      "eval-fixture-check": {
        "enabled": true
      },
      "system-health-check": {
        "enabled": true
      },
      "memo-writing": {
        "enabled": true
      },
      "source-improvement": {
        "enabled": true
      },
      "skillify": {
        "enabled": true
      },
      "resolver-check": {
        "enabled": true
      },
      "research-depth-control": {
        "enabled": true
      },
      "schema-proposal": {
        "enabled": true
      },
      "quiet-hours-reporting": {
        "enabled": true
      },
      "controlled-evolution": {
        "enabled": true
      }
    }
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": [
      "agents_list",
      "skill_workshop"
    ],
    "deny": [
      "gateway",
      "cron",
      "nodes",
      "sessions_send",
      "apply_patch"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "exec": {
      "host": "gateway",
      "mode": "allowlist",
      "timeoutSec": 420,
      "strictInlineEval": true,
      "notifyOnExit": true
    },
    "elevated": {
      "enabled": false
    },
    "subagents": {
      "tools": {
        "allow": [
          "exec",
          "read",
          "web_search",
          "web_fetch",
          "session_status"
        ],
        "deny": [
          "gateway",
          "cron",
          "nodes",
          "sessions_spawn",
          "sessions_send",
          "apply_patch",
          "write",
          "edit",
          "skill_workshop"
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "userTimezone": "Europe/Berlin",
      "skipBootstrap": true,
      "sandbox": {
        "mode": "off",
        "workspaceAccess": "none"
      },
      "compaction": {
        "memoryFlush": {
          "enabled": false
        }
      },
      "memorySearch": {
        "enabled": false,
        "sources": [
          "memory"
        ],
        "provider": "none",
        "store": {
          "fts": {
            "tokenizer": "unicode61"
          },
          "vector": {
            "enabled": false
          }
        }
      },
      "subagents": {
        "maxConcurrent": 3,
        "maxSpawnDepth": 1,
        "maxChildrenPerAgent": 3,
        "runTimeoutSeconds": 2700,
        "requireAgentId": true
      }
    },
    "list": [
      {
        "id": "vc-chief",
        "default": true,
        "name": "VC Chief",
        "workspace": "/workspaces/vc-chief",
        "agentDir": "/home/node/.openclaw/agents/vc-chief/agent",
        "model": "${VC_PRIMARY_MODEL}",
        "skills": [
          "lead-routing",
          "inbound-intake",
          "outbound-sourcing",
          "document-extraction",
          "evidence-research",
