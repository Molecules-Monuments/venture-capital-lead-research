  "session": {
    "dmScope": "per-channel-peer",
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "30d",
      "maxEntries": 500
    }
  },
  "cron": {
    "enabled": false,
    "maxConcurrentRuns": 1
  },
  "logging": {
    "maxFileBytes": 10485760
  }
