{
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": { "source": "env", "provider": "default", "id": "TELEGRAM_BOT_TOKEN" },
      "configWrites": false,
      "commands": { "native": false, "nativeSkills": false },
      "dmPolicy": "allowlist",
      "allowFrom": "__TELEGRAM_ALLOWED_USER_IDS__",
      "groupPolicy": "allowlist",
      "groupAllowFrom": "__TELEGRAM_ALLOWED_USER_IDS__",
      "groups": {
        "__TELEGRAM_ALLOWED_GROUP_ID__": {
          "enabled": true,
          "requireMention": true,
          "ingest": false,
          "groupPolicy": "allowlist",
          "allowFrom": "__TELEGRAM_ALLOWED_USER_IDS__"
        }
      },
      "contextVisibility": "allowlist",
      "richMessages": false,
      "streaming": { "mode": "off" },
      "mediaMaxMb": "__VC_CHANNEL_MEDIA_MAX_MB__",
      "mediaGroupFlushMs": 500,
      "pollingStallThresholdMs": 120000,
      "reactionNotifications": "off",
      "reactionLevel": "off",
      "linkPreview": false,
      "execApprovals": { "enabled": false },
      "threadBindings": {
        "enabled": false,
        "spawnSessions": false,
        "spawnSubagentSessions": false,
        "spawnAcpSessions": false
      },
      "network": { "dangerouslyAllowPrivateNetwork": false },
      "trustedLocalFileRoots": [],
      "autoTopicLabel": false,
      "errorPolicy": "silent",
      "actions": {
        "reactions": false,
        "sendMessage": false,
        "poll": false,
        "deleteMessage": false,
        "editMessage": false,
        "sticker": false,
        "createForumTopic": false,
        "editForumTopic": false
      },
      "retry": { "attempts": 3, "minDelayMs": 500, "maxDelayMs": 10000, "jitter": 0.2 }
    }
  },
  "bindings": [
    { "agentId": "vc-chief", "match": { "channel": "telegram", "accountId": "default" } }
  ]
}
